# ============================================================
#  MARU AI — Konfigurasi Penyimpanan Skill & Memori GitHub
#  Salin isi variabel ini ke file .env di root proyek (atau di
#  masing-masing folder divisi). JANGAN commit token asli!
# ============================================================

# Aktifkan sinkronisasi otomatis skill & memori ke GitHub (true/false)
MARU_GITHUB_SYNC_ENABLED=true

# Repository target penyimpanan skill & memori (format: owner/repo)
MARU_GITHUB_REPO=aryawisnu250376-beep/testing-maru-ai

# Branch penyimpanan (default: main)
MARU_GITHUB_BRANCH=main

# Fine-Grained Personal Access Token khusus repo testing-maru-ai
# Izin minimal: Repository permissions -> Contents: Read and write
MARU_GITHUB_TOKEN=

# Timeout HTTP ke GitHub API dalam detik (default: 20)
MARU_GITHUB_TIMEOUT=20
