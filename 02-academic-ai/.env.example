# Salinan template konfigurasi. Duplikat menjadi .env, lalu isi baris yang wajib.

# Telegram — wajib
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=

# 9Router lokal — wajib
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_TIMEOUT=90
NINE_ROUTER_MAX_RETRIES=3

# Endpoint spesialis/embedding/STT (opsional). Kosong = memakai 9Router di atas.
# MANAGER_CHAT_* adalah override KHUSUS AI Manager; kosong = ikut CHAT_BASE_URL/9Router.
# Contoh: MANAGER_CHAT_BASE_URL=http://localhost:11434/v1, MANAGER_CHAT_API_KEY=ollama.
# Lihat PANDUAN_OLLAMA_HERMES.md untuk mode hybrid (spesialis 9Router + Manager Hermes lokal).
CHAT_BASE_URL=
CHAT_API_KEY=
MANAGER_CHAT_BASE_URL=
MANAGER_CHAT_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
STT_BASE_URL=
STT_API_KEY=

# Wajib: salin ID tepat dari GET /v1/models/embedding di 9Router.
# Provider chat Kiro/OpenCode tidak otomatis menyediakan layanan embedding.
MODEL_EMBEDDING=

# Spesialis mata kuliah — contoh ID Kiro dari katalog/dokumen 9Router.
# ID harus tersedia di dashboard 9Router milikmu; gunakan --check --live untuk memeriksa.
MODEL_MANAGER=
# Wajib hanya untuk voice notes website. Salin exact ID dari GET /v1/models/stt;
# model chat tidak otomatis mendukung transkripsi audio.
MODEL_STT=
MODEL_PP_A=
MODEL_PP_B=
MODEL_PA_A=
MODEL_PA_B=
MODEL_BING_A=
MODEL_BING_B=
MODEL_PR_A=
MODEL_PR_B=
MODEL_ILKOM_A=
MODEL_ILKOM_B=
MODEL_KAP_A=
MODEL_KAP_B=
MODEL_DJ_A=
MODEL_DJ_B=

# Opsional: model fallback yang tersedia dan diizinkan oleh providernya.
# Periksa ID persis pada /v1/models; jangan menebak atau memakai OpenCode Free oc/auto.
# MODEL_FALLBACK_AGENT_A=<model-id-yang-diizinkan>
# MODEL_FALLBACK_AGENT_B=<model-id-yang-diizinkan>
# MODEL_FALLBACK_MANAGER=<model-id-yang-diizinkan>
# FALLBACK_MODEL=<model-id-yang-diizinkan>  # fallback umum lama; ditambahkan ke A, B, Manager
MODEL_FALLBACK_AGENT_A=
MODEL_FALLBACK_AGENT_B=
MODEL_FALLBACK_MANAGER=
FALLBACK_MODEL=

# Website/API: token rahasia internal, tidak perlu ditempel ke browser.
LOCAL_API_TOKEN=
# Website login: satu akun lokal, rahasiakan password dan file .env.
LOCAL_WEB_USERNAME=
LOCAL_WEB_PASSWORD=
# localhost = hanya laptop (default). Ganti ke lan agar bisa diakses HP di jaringan private/Wi-Fi yang sama.
# Mode lan bind ke 0.0.0.0 dan API tetap membatasi klien ke alamat private + wajib bearer token.
WEB_ACCESS_MODE=localhost
WEB_HOST=127.0.0.1
WEB_PORT=8765

# Backup PDF ke Google Drive per mata kuliah (opsional, default mati).
# Nyalakan dengan true + siapkan kredensial OAuth. Lihat PANDUAN_GDRIVE_BACKUP.md.
GDRIVE_BACKUP_ENABLED=false
GDRIVE_CREDENTIALS_FILE=data/drive_credentials.json
GDRIVE_TOKEN_FILE=data/drive_token.json
GDRIVE_ROOT_FOLDER=Academic_AI

# Batas dan perilaku aplikasi
# PDF hasil scan otomatis di-OCR saat upload bila Tesseract terinstal
# (Windows: winget install --id UB-Mannheim.TesseractOCR). Maks 80 halaman/file.
MAX_PDF_MB=20
MAX_AUDIO_MB=25
RAG_TOP_K=5
# Varian redaksi kueri per pertanyaan (1-5). Lebih banyak = recall lebih baik, konteks lebih besar.
RAG_QUERY_VARIANTS=3
RAG_MIN_SCORE=0.12
MAX_OUTPUT_TOKENS=2500
MAX_REVISION_ROUNDS=2
MAX_CONTEXT_CHARS=60000
LOG_LEVEL=INFO
# Video penjelasan: butuh ffmpeg + piper-tts/edge-tts (pip). TTS_PROVIDER=auto|piper|edge.
TTS_PROVIDER=auto
TTS_VOICE=id_ID-fajri-medium
VIDEO_MAX_SCENES=6
# Retrieval: vector (default) | tree (struktur) | hybrid
RAG_MODE=vector
# Memori user + skill Hermes (true/false)
MEMORY_ENABLED=true
SKILLS_LEARN_ENABLED=true
WEB_RESEARCH_ENABLED=false

# ==== AI Teknisi (pantau log + perbaiki bug otomatis) ====
TECHNICIAN_ENABLED=true
TECHNICIAN_AUTO=true
TECHNICIAN_MODE=safe
TECHNICIAN_INTERVAL_MIN=30
TECHNICIAN_CODE_FIX=true

# ==== Penyimpanan Skill & Memori GitHub MARU (opsional) ====
MARU_GITHUB_SYNC_ENABLED=false
MARU_GITHUB_REPO=aryawisnu250376-beep/testing-maru-ai
MARU_GITHUB_BRANCH=main
MARU_GITHUB_TOKEN=

