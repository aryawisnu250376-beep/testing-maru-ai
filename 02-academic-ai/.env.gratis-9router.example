# Template profil model gratis 9Router untuk Academic AI.
# Salin menjadi .env, lalu isi key 9Router dan MODEL_EMBEDDING. Isi token Telegram/user ID jika memakai bot.
# Jangan kirim token/API key; .env sudah di-ignore oleh Git.
#
# Model Kiro di bawah mengikuti daftar provider 9Router yang ditemukan 8 Oktober 2026.
# Kuota Kiro gratis terbatas (dokumen repo menyebut sekitar 50 credits/bulan); daftar/model
# dapat berubah. Setiap request memakai dua specialist + Manager, dan revisi menambah panggilan.
#
# STRATEGI HEMAT KUOTA (template ini):
# - Specialist A/B memakai model ringan & murah (Haiku + alternatif murah) karena mereka
#   dipanggil PALING SERING (2x per ronde, dan dipanggil lagi setiap ada revisi).
# - Model terkuat (Sonnet) hanya dipakai Manager (juri) yang dipanggil 1x per ronde.
#   Hasil: kualitas penilaian naik, pemakaian model mahal turun.
# - MAX_REVISION_ROUNDS=1 (bukan 2): kasus terburuk 6 panggilan/tanya, bukan 9.
# - Embedding & STT bisa gratis tanpa batas bila dipindah ke Ollama lokal
#   (lihat .env.ollama-hermes.example); template ini membiarkannya di 9Router.

TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=

NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_TIMEOUT=90
NINE_ROUTER_MAX_RETRIES=3

# Endpoint AI per peran (opsional). Kosong = memakai 9Router di atas.
# Untuk Hermes lokal via Ollama, lihat PANDUAN_OLLAMA_HERMES.md dan .env.ollama-hermes.example.
CHAT_BASE_URL=
CHAT_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
STT_BASE_URL=
STT_API_KEY=

# Wajib untuk PDF/RAG. Hubungkan provider embedding di dashboard 9Router,
# lalu pilih ID persis dari GET http://localhost:20128/v1/models/embedding.
# Contoh nama provider/model dan prefix bisa berubah; jangan tebak ID.
MODEL_EMBEDDING=

# Tiga AI specialist per mata kuliah (independen; B/C tidak melihat draft lain).
# Semua A = Haiku (murah, dipanggil paling sering); B/C = alternatif murah (diversifikasi).
# Jalankan "python tools/probe_models.py --patch-env" untuk mengisi otomatis sesuai hasil uji.
MODEL_PP_A=kr/claude-haiku-4.5
MODEL_PP_B=kr/glm-5
MODEL_PP_C=kr/deepseek-3.2
MODEL_PA_A=kr/claude-haiku-4.5
MODEL_PA_B=kr/MiniMax-M2.5
MODEL_PA_C=kr/deepseek-3.2
MODEL_BING_A=kr/claude-haiku-4.5
MODEL_BING_B=kr/glm-5
MODEL_BING_C=kr/deepseek-3.2
MODEL_PR_A=kr/claude-haiku-4.5
MODEL_PR_B=kr/deepseek-3.2
MODEL_PR_C=kr/MiniMax-M2.5
MODEL_ILKOM_A=kr/claude-haiku-4.5
MODEL_ILKOM_B=kr/MiniMax-M2.5
MODEL_ILKOM_C=kr/deepseek-3.2
MODEL_KAP_A=kr/claude-haiku-4.5
MODEL_KAP_B=kr/glm-5
MODEL_KAP_C=kr/deepseek-3.2
MODEL_DJ_A=kr/claude-haiku-4.5
MODEL_DJ_B=kr/qwen3-coder-next
MODEL_DJ_C=kr/deepseek-3.2
# Manager = juri terkuat (Sonnet), hanya 1x panggil per ronde.
MODEL_MANAGER=kr/claude-sonnet-4.5
# Pilih model dari GET http://localhost:20128/v1/models/stt.
# Ini sengaja terpisah dari chat model; isi hanya bila katalog STT menampilkan ID yang sesuai.
MODEL_STT=

# Opsional: fallback model yang memang tersedia dan boleh dipakai lewat 9Router.
# Nilai oc/auto dari contoh terlampir sengaja tidak diaktifkan: OpenCode Free bermasalah
# dengan 403 pada September 2026 dan pihak OpenCode menyatakan tier gratisnya hanya boleh
# dipakai di klien OpenCode, bukan lewat router pihak ketiga. Pilih alternatif yang diizinkan.
# Contoh: setelah menghubungkan Cloudflare Workers AI atau Vertex di dashboard 9Router,
# salin model ID persis dari GET http://localhost:20128/v1/models.
# MODEL_FALLBACK_AGENT_A=<ID-katalog-yang-berizin>
# MODEL_FALLBACK_AGENT_B=<ID-katalog-yang-berizin>
# MODEL_FALLBACK_MANAGER=<ID-katalog-yang-berizin>
MODEL_FALLBACK_AGENT_A=
MODEL_FALLBACK_AGENT_B=
MODEL_FALLBACK_AGENT_C=
MODEL_FALLBACK_MANAGER=
FALLBACK_MODEL=

# Website lokal secara default. Isi token acak; jangan bagikan.
LOCAL_API_TOKEN=
# Website login; keep the password private in this local .env file.
LOCAL_WEB_USERNAME=
LOCAL_WEB_PASSWORD=
# Ubah localhost ke lan agar HP dapat membuka web dari jaringan Wi-Fi/private yang sama.
# Mode lan tetap perlu Bearer token; bind ke 0.0.0.0 dan hanya izinkan alamat client private.
WEB_ACCESS_MODE=localhost
WEB_HOST=127.0.0.1
WEB_PORT=8765
# PDF hasil scan otomatis di-OCR saat upload bila Tesseract terinstal
# (Windows: winget install --id UB-Mannheim.TesseractOCR). Maks 80 halaman/file.
MAX_PDF_MB=20
MAX_AUDIO_MB=25
# Pengungkit hemat lain (opsional, ada tradeoff kualitas):
# - MAX_OUTPUT_TOKENS lebih kecil = jawaban lebih pendek & murah (jangan <1500 agar kuis tak terpotong).
# - RAG_TOP_K lebih kecil = konteks lebih sedikit & murah (minimal 3 agar bukti tetap cukup).
RAG_TOP_K=8
# Varian redaksi kueri per pertanyaan (1-5). Lebih banyak = recall lebih baik, konteks lebih besar.
RAG_QUERY_VARIANTS=4
RAG_MIN_SCORE=0.12
MAX_OUTPUT_TOKENS=2500
# Hemat kuota: 1 ronde revisi (kasus terburuk 6 panggilan model per pertanyaan).
# Naikkan ke 2 hanya bila butuh kualitas maksimal dan kuota cukup.
MAX_REVISION_ROUNDS=1
MAX_CONTEXT_CHARS=60000
LOG_LEVEL=INFO
# Video penjelasan: butuh ffmpeg + piper-tts/edge-tts (pip). TTS_PROVIDER=auto|piper|edge.
TTS_PROVIDER=auto
TTS_VOICE=id_ID-fajri-medium
VIDEO_MAX_SCENES=6
# Retrieval: vector (default) | tree (struktur) | hybrid
RAG_MODE=vector
# Memori user + skill Hermes (true/false)
MEMORY_ENABLED=true
SKILLS_LEARN_ENABLED=true
WEB_RESEARCH_ENABLED=false

# ==== AI Teknisi (pantau log + perbaiki bug otomatis) ====
TECHNICIAN_ENABLED=true
TECHNICIAN_AUTO=true
TECHNICIAN_MODE=safe
TECHNICIAN_INTERVAL_MIN=30
TECHNICIAN_CODE_FIX=true
