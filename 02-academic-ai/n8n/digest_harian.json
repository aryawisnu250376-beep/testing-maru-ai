{
  "name": "Academic AI - Digest Harian",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "cronExpression": "0 21 * * *"
            }
          ]
        }
      },
      "id": "sched-digest-001",
      "name": "Jadwal Malam",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8765/api/stats",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer GANTI_DENGAN_LOCAL_API_TOKEN"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "http-digest-001",
      "name": "Ambil Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s = $input.first().json;\nconst lines = ['📊 Digest Academic AI'];\nfor (const subj of s.subjects || []) {\n  lines.push(`- ${subj.code}: ${subj.documents} PDF, ${subj.chunks} chunk`);\n}\nconst vers = s.recent_verifications || [];\nif (vers.length) {\n  lines.push('', 'Verifikasi terakhir:');\n  for (const v of vers.slice(0, 5)) {\n    const conf = Number(v.confidence || 0).toFixed(2);\n    lines.push(`• ${v.decision} (${conf}) — ${(v.reason || '').slice(0, 100)}`);\n  }\n} else {\n  lines.push('', 'Belum ada pertanyaan yang diverifikasi.');\n}\nreturn [{ json: { text: lines.join('\\n').slice(0, 3800) } }];"
      },
      "id": "code-digest-001",
      "name": "Format Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "GANTI_DENGAN_CHAT_ID",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "disable_web_page_preview": true
        }
      },
      "id": "tg-digest-001",
      "name": "Kirim Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Jadwal Malam": {
      "main": [
        [
          {
            "node": "Ambil Stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ambil Stats": {
      "main": [
        [
          {
            "node": "Format Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Digest": {
      "main": [
        [
          {
            "node": "Kirim Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta"
  },
  "pinData": {}
}
