# ============================================================
#  SEMUA KOSONG = pipeline tetap jalan penuh (mode template, $0)
#  Isi satu per satu kalau mau naik kualitas.
# ============================================================

# ----- LLM (opsional; tanpa ini script pakai template offline) -----
# 9Router lokal:   http://localhost:20128/v1
# Ollama lokal:    http://localhost:11434/v1   (LLM_MODEL=qwen2.5:3b)
# Groq (gratis):   https://api.groq.com/openai/v1
# Gemini (gratis): https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Model per task (kosong = pakai LLM_MODEL)
LLM_MODEL_CHEAP=      # klasifikasi trend (volume tinggi)
LLM_MODEL_STRONG=     # nulis script + hook
LLM_MODEL_QC=         # fact-check

# Rantai fallback gratis (dipakai otomatis kalau LLM_BASE_URL kosong)
OLLAMA_BASE_URL=      # contoh: http://localhost:11434/v1
OLLAMA_MODEL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ----- Sumber trend tambahan (opsional) -----
YOUTUBE_API_KEY=      # free tier 10k unit/hari; proxy terbaik "video apa yang naik"
GITHUB_TOKEN=         # naikkan rate limit GitHub search 10 -> 30 req/menit

# ----- Gerbang ACC -----
TELEGRAM_BOT_TOKEN=   # dari @BotFather
TELEGRAM_CHAT_ID=

# ----- TikTok Content Posting API (FASE 3, butuh audit untuk publik) -----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
PUBLISH_MODE=manual   # manual | draft | direct

# ----- Lain-lain -----
FFMPEG_BINARY=        # paksa path ffmpeg tertentu (opsional)
HOST=0.0.0.0
PORT=8080

# ============================================================
#  KERANGKA 4 BOT (9Router / Hermes / MausBot / Ootto)
# ============================================================

# ----- 9Router (lapisan model, lokal saja) -----
# Jalankan: npm install -g 9router && 9router
# Dashboard: http://localhost:20128/dashboard  (JANGAN ekspos ke internet)
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=
ROUTER_MODEL=

# ----- Hermes (otak; WSL2 di Windows) -----
# Hermes membaca config/hermes/config.yaml. Tidak menyimpan kredensial TikTok.
MAKS_PUTARAN_REVISI=2
HERMES_MAX_LANGKAH=25

# ----- Ootto (penjadwal TikTok) -----
# draft = kirim ke inbox TikTok, pemilik tayang sendiri (BAWAAN, paling aman)
# direct = tayang langsung, HANYA setelah pemilik meminta + audit TikTok lulus
OOTTO_MODE=draft
OOTTO_ALLOW_DIRECT=false
ZONA_WAKTU=Asia/Jakarta

# ----- TikTok OAuth (resmi, bisa dicabut; JANGAN password) -----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_TOKEN_EXPIRES=0

# ----- Riset (opsional, self-host) -----
SEARXNG_URL=http://localhost:8888
MINIFLUX_URL=
MINIFLUX_TOKEN=

# ----- Keamanan dashboard -----
STUDIO_PASSWORD=

# ----- Sinkronisasi Skill & Memori ke GitHub MARU (opsional) -----
MARU_GITHUB_SYNC_ENABLED=false
MARU_GITHUB_REPO=aryawisnu250376-beep/testing-maru-ai
MARU_GITHUB_BRANCH=main
MARU_GITHUB_TOKEN=

